# Copy to .env and edit. .env is not tracked.

# Optional parts of the stack started by a plain `docker compose up -d`:
# manga (Suwayomi and Kavita) and server (Jellyfin and Seerr), comma separated.
COMPOSE_PROFILES=manga

# Windows folder holding downloads and the library. Keep both on one drive so
# Radarr and Sonarr can hardlink instead of copying.
MEDIA_ROOT=/mnt/d/Media

# App settings and databases. Keep these on the WSL disk: SQLite is unreliable
# on /mnt/c and /mnt/d.
CONFIG_ROOT=~/.local/share/media

PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Port qBittorrent listens on for peers. Pick any random port from 1025 to 65535;
# if torrents do not start, try another one.
TORRENTING_PORT=52817

# Login for qBittorrent, Radarr, Sonarr, Prowlarr and Kavita, set by configure.py.
# Leave the password empty and configure.py asks for one.
MEDIA_USERNAME=admin
MEDIA_PASSWORD=

# Optional. Use the OpenSubtitles.com username, not the email address.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# How long a download may sit on metadata or stalled before it is replaced.
STALLED_HOURS=72
