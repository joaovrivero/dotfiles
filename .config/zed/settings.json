{
  "wsl_connections": [
    {
      "distro_name": "Arch",
      "user": null,
      "projects": [
        {
          "paths": [
            "/home/jojo/.config"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "session": {
    "trust_all_worktrees": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "terminal": {
    "dock": "bottom"
  },
  "icon_theme": "Base Charmed Icons",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent_buffer_font_size": 20.0,
  "agent": {
    "sidebar_side": "left",
    "flexible": true,
    "dock": "right",
    "default_profile": "ask",
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 18.0,
  "current_line_highlight": "gutter",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Pinacoteca"
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_user_menu": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "semantic_tokens": "combined",
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "token_type": "namespace",
        "style": [
          "namespace",
          "module",
          "type"
        ]
      },
      {
        "token_type": "type",
        "style": [
          "type"
        ]
      },
      {
        "token_type": "class",
        "style": [
          "type.class",
          "type"
        ]
      },
      {
        "token_type": "enum",
        "style": [
          "enum",
          "type"
        ]
      },
      {
        "token_type": "interface",
        "style": [
          "type.interface",
          "type"
        ]
      },
      {
        "token_type": "struct",
        "style": [
          "type.struct",
          "type"
        ]
      },
      {
        "token_type": "typeParameter",
        "style": [
          "type.parameter",
          "type"
        ]
      },
      {
        "token_type": "parameter",
        "style": [
          "variable.parameter",
          "variable"
        ]
      },
      {
        "token_type": "variable",
        "token_modifiers": [
          "readonly"
        ],
        "style": [
          "constant",
          "variable"
        ]
      },
      {
        "token_type": "variable",
        "style": [
          "variable"
        ]
      },
      {
        "token_type": "property",
        "style": [
          "variable.member",
          "property"
        ]
      },
      {
        "token_type": "enumMember",
        "style": [
          "variant",
          "constant"
        ]
      },
      {
        "token_type": "function",
        "style": [
          "function"
        ]
      },
      {
        "token_type": "method",
        "style": [
          "function.method",
          "function"
        ]
      },
      {
        "token_type": "macro",
        "style": [
          "macro",
          "function"
        ]
      },
      {
        "token_type": "keyword",
        "style": [
          "keyword"
        ]
      },
      {
        "token_type": "comment",
        "token_modifiers": [
          "documentation"
        ],
        "style": [
          "comment.doc",
          "comment"
        ]
      },
      {
        "token_type": "comment",
        "style": [
          "comment"
        ]
      },
      {
        "token_type": "string",
        "style": [
          "string"
        ]
      },
      {
        "token_type": "number",
        "style": [
          "number"
        ]
      },
      {
        "token_type": "operator",
        "style": [
          "operator"
        ]
      }
    ]
  }
}
