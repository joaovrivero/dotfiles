  "editor.tokenColorCustomizations": {
    "[Default Dark Modern]": {
      "comments": "#7d6b59",
      "strings": "#88ab75",
      "keywords": "#ad8ab6",
      "numbers": "#d77f47",
      "types": "#d7a447",
      "functions": "#799dbb",
      "variables": "#e6ccaf",
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#7d6b59",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "punctuation",
            "meta.brace",
            "punctuation.separator",
            "punctuation.terminator",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#b19a80"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other",
            "variable.parameter",
            "variable.other.property",
            "meta.object-literal.key",
            "support.variable"
          ],
          "settings": {
            "foreground": "#e6ccaf"
          }
        },
        {
          "scope": [
            "variable.language",
            "support.variable.property.dom"
          ],
          "settings": {
            "foreground": "#d67066"
          }
        },
        {
          "scope": [
            "constant",
            "constant.numeric",
            "constant.language",
            "support.constant"
          ],
          "settings": {
            "foreground": "#d77f47"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted",
            "string.template"
          ],
          "settings": {
            "foreground": "#88ab75"
          }
        },
        {
          "scope": [
            "constant.character.escape",
            "string.regexp",
            "punctuation.definition.template-expression"
          ],
          "settings": {
            "foreground": "#6cabab"
          }
        },
        {
          "scope": [
            "keyword",
            "storage.type",
            "storage.modifier",
            "keyword.control"
          ],
          "settings": {
            "foreground": "#ad8ab6"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call entity.name.function",
            "entity.name.function.member"
          ],
          "settings": {
            "foreground": "#799dbb"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class",
            "entity.other.inherited-class",
            "entity.name.namespace"
          ],
          "settings": {
            "foreground": "#d7a447"
          }
        },
        {
          "scope": [
            "entity.name.tag"
          ],
          "settings": {
            "foreground": "#799dbb"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name"
          ],
          "settings": {
            "foreground": "#e6ccaf"
          }
        },
        {
          "scope": [
            "markup.heading",
            "entity.name.section"
          ],
          "settings": {
            "foreground": "#d7a447",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.bold"
          ],
          "settings": {
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.inline.raw",
            "markup.fenced_code.block"
          ],
          "settings": {
            "foreground": "#6cabab"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link"
          ],
          "settings": {
            "foreground": "#799dbb"
          }
        },
        {
          "scope": [
            "markup.inserted"
          ],
          "settings": {
            "foreground": "#88ab75"
          }
        },
        {
          "scope": [
            "markup.deleted"
          ],
          "settings": {
            "foreground": "#d67066"
          }
        },
        {
          "scope": [
            "markup.changed"
          ],
          "settings": {
            "foreground": "#799dbb"
          }
        },
        {
          "scope": [
            "invalid",
            "invalid.illegal"
          ],
          "settings": {
            "foreground": "#d67066"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Default Dark Modern]": {
      "enabled": true,
      "rules": {
        "variable": "#e6ccaf",
        "parameter": "#e6ccaf",
        "property": "#e6ccaf",
        "variable.defaultLibrary": "#d67066",
        "function": "#799dbb",
        "method": "#799dbb",
        "class": "#d7a447",
        "type": "#d7a447",
        "interface": "#d7a447",
        "enum": "#d7a447",
        "enumMember": "#d77f47",
        "keyword": "#ad8ab6",
        "string": "#88ab75",
        "number": "#d77f47",
        "regexp": "#6cabab",
        "comment": {
          "foreground": "#7d6b59",
          "italic": true
        },
        "namespace": "#e6ccaf",
        "decorator": "#6cabab",
        "macro": "#6cabab"
      }
    }
  }
}
