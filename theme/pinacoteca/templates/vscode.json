  "editor.tokenColorCustomizations": {
    "[Default Dark Modern]": {
      "comments": "{{comment}}",
      "strings": "{{green}}",
      "keywords": "{{purple}}",
      "numbers": "{{orange}}",
      "types": "{{gold}}",
      "functions": "{{blue}}",
      "variables": "{{fg}}",
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "{{comment}}",
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "punctuation",
            "meta.brace",
            "punctuation.separator",
            "punctuation.terminator",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "{{fg_dim}}"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other",
            "variable.parameter",
            "variable.other.property",
            "meta.object-literal.key",
            "support.variable"
          ],
          "settings": {
            "foreground": "{{fg}}"
          }
        },
        {
          "scope": [
            "variable.language",
            "support.variable.property.dom"
          ],
          "settings": {
            "foreground": "{{red}}"
          }
        },
        {
          "scope": [
            "constant",
            "constant.numeric",
            "constant.language",
            "support.constant"
          ],
          "settings": {
            "foreground": "{{orange}}"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted",
            "string.template"
          ],
          "settings": {
            "foreground": "{{green}}"
          }
        },
        {
          "scope": [
            "constant.character.escape",
            "string.regexp",
            "punctuation.definition.template-expression"
          ],
          "settings": {
            "foreground": "{{aqua}}"
          }
        },
        {
          "scope": [
            "keyword",
            "storage.type",
            "storage.modifier",
            "keyword.control"
          ],
          "settings": {
            "foreground": "{{purple}}"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call entity.name.function",
            "entity.name.function.member"
          ],
          "settings": {
            "foreground": "{{blue}}"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class",
            "entity.other.inherited-class",
            "entity.name.namespace"
          ],
          "settings": {
            "foreground": "{{gold}}"
          }
        },
        {
          "scope": [
            "entity.name.tag"
          ],
          "settings": {
            "foreground": "{{blue}}"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name"
          ],
          "settings": {
            "foreground": "{{fg}}"
          }
        },
        {
          "scope": [
            "markup.heading",
            "entity.name.section"
          ],
          "settings": {
            "foreground": "{{gold}}",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.bold"
          ],
          "settings": {
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "settings": {
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "markup.inline.raw",
            "markup.fenced_code.block"
          ],
          "settings": {
            "foreground": "{{aqua}}"
          }
        },
        {
          "scope": [
            "markup.underline.link",
            "string.other.link"
          ],
          "settings": {
            "foreground": "{{blue}}"
          }
        },
        {
          "scope": [
            "markup.inserted"
          ],
          "settings": {
            "foreground": "{{green}}"
          }
        },
        {
          "scope": [
            "markup.deleted"
          ],
          "settings": {
            "foreground": "{{red}}"
          }
        },
        {
          "scope": [
            "markup.changed"
          ],
          "settings": {
            "foreground": "{{blue}}"
          }
        },
        {
          "scope": [
            "invalid",
            "invalid.illegal"
          ],
          "settings": {
            "foreground": "{{red}}"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Default Dark Modern]": {
      "enabled": true,
      "rules": {
        "variable": "{{fg}}",
        "parameter": "{{fg}}",
        "property": "{{fg}}",
        "variable.defaultLibrary": "{{red}}",
        "function": "{{blue}}",
        "method": "{{blue}}",
        "class": "{{gold}}",
        "type": "{{gold}}",
        "interface": "{{gold}}",
        "enum": "{{gold}}",
        "enumMember": "{{orange}}",
        "keyword": "{{purple}}",
        "string": "{{green}}",
        "number": "{{orange}}",
        "regexp": "{{aqua}}",
        "comment": {
          "foreground": "{{comment}}",
          "italic": true
        },
        "namespace": "{{fg}}",
        "decorator": "{{aqua}}",
        "macro": "{{aqua}}"
      }
    }
  }
}
